managed implementation in class zbp_c_spac107_stock unique;
strict ( 2 );

define behavior for ZC_SPAC107_STOCK //alias <alias_name>
persistent table zspac107_stock
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) WarehouseId;
  mapping for ZSPAC107_STOCK corresponding {
    WarehouseId = warehouse_id;
    ProductId = product_id;
  }
}