managed implementation in class zbp_r_spac107_product unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC107_PRODUCT //alias <alias_name>
persistent table zspac107_product
draft table zspac107_d_proc
lock master total etag LastChangedAt
authorization master ( instance )
early numbering
etag master LastChangedAt
{
  create;
  update;
  delete;
  field ( readonly ) ProductId;

  field ( mandatory ) ProductName;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zspac107_product corresponding{
    ProductId = product_id;
    ProductName = product_name;
    ProductDesctiption = product_desctiption;
    Price = price;
    CreatedBy = local_created_by;
    CreatedAt = local_created_at;
    LastChangedBy = local_last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}