managed implementation in class zbp_r_spac107_product unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC107_PRODUCT //alias <alias_name>
persistent table zspac107_product
draft table zspac107_d_proc
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LastChangedAt
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) ProductId;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
}